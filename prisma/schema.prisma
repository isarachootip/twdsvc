generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String         @id @default(cuid())
  username         String         @unique
  password         String
  fullName         String
  email            String?
  role             Role           @default(CS)
  siteId           String?
  vendorCenterId   String?
  active           Boolean        @default(true)
  failedLoginCount Int            @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  refreshTokens    RefreshToken[]
  site             Site?          @relation(fields: [siteId], references: [id])
  vendorCenter     VendorCenter?  @relation(fields: [vendorCenterId], references: [id])

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Site {
  id                String              @id @default(cuid())
  code              String              @unique
  stCode            String?
  name              String
  nameEn            String?
  nickname          String
  legalName         String?
  type              SiteType            @default(BRANCH)
  province          String              @default("กรุงเทพมหานคร")
  district          String?
  subdistrict       String?
  postalCode        String?
  address           String?
  latitude          Float?
  longitude         Float?
  googleMapsUrl     String?
  phone             String?
  storeManagerName  String?
  storeManagerPhone String?
  storeEmail        String?
  groupEmail        String?
  openingHours      String?
  rcvOpeningHours   String?
  storeGroup        String?
  rom               String?
  region            String?
  districtManager   String?
  active            Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  primaryRoutes     BranchVendorRoute[] @relation("PrimaryBranch")
  dcCoverage        BranchVendorRoute[] @relation("DCCoverage")
  jobs              Job[]
  users             User[]

  @@map("sites")
}

model VendorParent {
  id                      String         @id @default(cuid())
  code                    String         @unique
  name                    String
  defaultGpPct            Float          @default(18.0)
  defaultRepairSlaDays    Int            @default(7)
  repairWarrantyDays      Int            @default(30)
  inspectionFeeCovered    Int            @default(0)
  inspectionFeeNotCovered Int            @default(300)
  isBrandAuthorized       Boolean        @default(false)
  active                  Boolean        @default(true)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  brands                  VendorBrand[]
  centers                 VendorCenter[]

  @@map("vendor_parents")
}

model VendorCenter {
  id                    String              @id @default(cuid())
  code                  String              @unique
  vendorParentId        String
  zoneSiteId            String?
  address               String?
  phone                 String?
  deliveryMethod        String              @default("DC")
  gpPctOverride         Float?
  repairSlaDaysOverride Int?
  active                Boolean             @default(true)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  backupRoutes          BranchVendorRoute[] @relation("BackupCenter")
  primaryRoutes         BranchVendorRoute[] @relation("PrimaryCenter")
  jobs                  Job[]
  users                 User[]
  vendorParent          VendorParent        @relation(fields: [vendorParentId], references: [id])

  @@map("vendor_centers")
}

model VendorBrand {
  vendorParentId String
  brandId        Int
  brand          Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  vendorParent   VendorParent @relation(fields: [vendorParentId], references: [id], onDelete: Cascade)

  @@id([vendorParentId, brandId])
  @@map("vendor_brands")
}

model BranchVendorRoute {
  id              String        @id @default(cuid())
  branchId        String
  dcSiteId        String?
  primaryCenterId String?
  backupCenterId  String?
  standardChannel Channel       @default(DC)
  priority        Int           @default(1)
  backupCenter    VendorCenter? @relation("BackupCenter", fields: [backupCenterId], references: [id])
  branch          Site          @relation("PrimaryBranch", fields: [branchId], references: [id])
  dcSite          Site?         @relation("DCCoverage", fields: [dcSiteId], references: [id])
  primaryCenter   VendorCenter? @relation("PrimaryCenter", fields: [primaryCenterId], references: [id])

  @@map("branch_vendor_routes")
}

model Brand {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  active       Boolean       @default(true)
  vendorBrands VendorBrand[]

  @@map("brands")
}

model SizeCategory {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  name      String
  sortOrder Int       @default(0)
  feeRates  FeeRate[]

  @@map("size_categories")
}

model FeeRate {
  id             Int          @id @default(autoincrement())
  sizeCategoryId Int
  operationFee   Int          @default(0)
  shippingFee3pl Int          @default(0)
  effectiveFrom  DateTime     @default(now())
  sizeCategory   SizeCategory @relation(fields: [sizeCategoryId], references: [id])

  @@map("fee_rates")
}

model ProductType {
  id   Int    @id @default(autoincrement())
  code String @unique
  name String

  @@map("product_types")
}

model Commodity {
  id               Int      @id @default(autoincrement())
  sku              String   @unique
  barcode          String?
  name             String
  brand            String
  productType      String
  active           Boolean  @default(true)
  // ─── Full MASTER_SKU columns (1:1 with Excel header) ───
  ibc              String?
  sbc              String?
  barcode2         String?
  barcode3         String?
  barcode4         String?
  barcode5         String?
  skuCondition     String?
  skuConditionName String?
  brandCode        String?  // Excel: brand_id
  model            String?
  vendorNo         String?
  vendorName       String?
  deptNo           String?
  deptName         String?
  sdeptNo          String?
  sdeptName        String?
  classNo          String?
  className        String?
  sclassNo         String?
  sclassName       String?
  unitCode         String?
  unitName         String?
  skuStatusCode    String?
  skuStatusName    String?
  skuPrice         Decimal? @db.Decimal(14, 2)
  skuCost          Decimal? @db.Decimal(14, 2)
  distrmcode       String?
  norprice         Decimal? @db.Decimal(14, 2)
  posprice         Decimal? @db.Decimal(14, 2)

  @@index([brand])
  @@index([deptName])
  @@index([className])
  @@index([barcode])
  @@index([active])
  @@map("commodities")
}

model Job {
  id              String            @id @default(cuid())
  jobNo           String            @unique
  type            JobType           @default(CUSTOMER)
  stage           JobStage          @default(CS_OPENED)
  channel         Channel?
  stageEnteredAt  DateTime          @default(now())
  version         Int               @default(1)
  branchId        String
  vendorCenterId  String?
  customerName    String?
  customerPhone   String?
  customerAddress String?
  customerZip     String?
  taxInvoiceName  String?
  taxInvoiceId    String?
  taxInvoiceAddr  String?
  sku             String?
  productName     String
  brandId         Int?
  brandName       String
  sizeCategoryId  Int?
  symptom         String?
  serialNo        String?
  hasWarranty     Boolean           @default(false)
  allowNonAuth    Boolean           @default(false)
  shippingMethod  String            @default("STANDARD")
  receiverName    String?
  decision        QuoteDecision     @default(PENDING)
  closedAt        DateTime?
  createdBy       String
  openedAt        DateTime          @default(now())
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  charges         JobCharge[]
  events          JobEvent[]
  items           JobItem[]
  branch          Site              @relation(fields: [branchId], references: [id])
  vendorCenter    VendorCenter?     @relation(fields: [vendorCenterId], references: [id])
  payments        Payment[]
  payoutLines     PayoutBatchLine[]
  publicTokens    PublicToken[]
  quotes          Quote[]
  shipments       Shipment[]
  slaClocks       SlaClock[]
  tradeIns        TradeIn[]

  @@map("jobs")
}

model JobItem {
  id          String  @id @default(cuid())
  jobId       String
  sku         String?
  productName String
  quantity    Int     @default(1)
  holdStockNo String?
  symptom     String?
  job         Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("job_items")
}

model JobEvent {
  id          String       @id @default(cuid())
  jobId       String
  type        String
  fromStage   JobStage?
  toStage     JobStage?
  actorUserId String?
  actorRole   String?
  payload     Json?
  note        String?
  createdAt   DateTime     @default(now())
  attachments Attachment[]
  job         Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("job_events")
}

model JobCharge {
  id          String     @id @default(cuid())
  jobId       String
  type        ChargeType
  amount      Int
  description String?
  createdAt   DateTime   @default(now())
  job         Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("job_charges")
}

model SlaStep {
  id         Int        @id @default(autoincrement())
  seq        Int        @unique
  code       String     @unique
  name       String
  startEvent String
  stopEvent  String
  ownerDept  String
  hours      Int        @default(24)
  appliesTo  String     @default("CUSTOMER,STOCK")
  condition  String?
  pausable   Boolean    @default(false)
  active     Boolean    @default(true)
  clocks     SlaClock[]

  @@map("sla_steps")
}

model SlaClock {
  id            String         @id @default(cuid())
  jobId         String
  slaStepId     Int
  status        SlaClockStatus @default(RUNNING)
  startedAt     DateTime       @default(now())
  dueAt         DateTime
  stoppedAt     DateTime?
  pausedAt      DateTime?
  pausedMinutes Int            @default(0)
  breached      Boolean        @default(false)
  breachedAt    DateTime?
  job           Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  slaStep       SlaStep        @relation(fields: [slaStepId], references: [id])

  @@unique([jobId, slaStepId])
  @@map("sla_clocks")
}

model Shipment {
  id           String          @id @default(cuid())
  jobId        String
  legType      ShipmentLegType
  carrier      CarrierType
  status       ShipmentStatus  @default(PENDING_DISPATCH)
  trackingNo   String?
  driverToken  String?
  dispatchedAt DateTime?
  pickedUpAt   DateTime?
  deliveredAt  DateTime?
  cancelledAt  DateTime?
  cost         Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  job          Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("shipments")
}

model Attachment {
  id         String   @id @default(cuid())
  jobEventId String
  kind       String
  fileName   String
  fileUrl    String
  fileSize   Int?
  mimeType   String?
  uploadedBy String?
  createdAt  DateTime @default(now())
  jobEvent   JobEvent @relation(fields: [jobEventId], references: [id], onDelete: Cascade)

  @@map("attachments")
}

model Quote {
  id                 String      @id @default(cuid())
  jobId              String
  quoteNo            String      @unique
  version            Int         @default(1)
  status             QuoteStatus @default(SENT)
  subtotal           Int         @default(0)
  vatAmount          Int         @default(0)
  total              Int         @default(0)
  repairDays         Int         @default(1)
  repairWarrantyDays Int         @default(30)
  vendorNote         String?
  sentAt             DateTime?
  expiresAt          DateTime?
  decidedAt          DateTime?
  createdBy          String
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  lines              QuoteLine[]
  job                Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("quotes")
}

model QuoteLine {
  id               String        @id @default(cuid())
  quoteId          String
  type             QuoteLineType
  description      String
  unitPrice        Int           @default(0)
  quantity         Int           @default(1)
  partWaitDays     Int           @default(0)
  partWarrantyDays Int           @default(0)
  approved         Boolean?
  quote            Quote         @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@map("quote_lines")
}

model Payment {
  id           String        @id @default(cuid())
  jobId        String
  chargeType   ChargeType
  amount       Int
  method       PaymentMethod
  status       PaymentStatus @default(PENDING)
  posReceiptNo String?
  externalRef  String?
  receivedBy   String?
  receivedAt   DateTime?
  voidedAt     DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  job          Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model PublicToken {
  id        String    @id @default(cuid())
  jobId     String
  type      TokenType
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("public_tokens")
}

model PromotionConfig {
  id             String      @id @default(cuid())
  name           String
  tradeInType    TradeInType
  sizeCategoryId Int?
  subDept        String?
  discountPct    Float
  startDate      DateTime
  endDate        DateTime
  status         String      @default("ACTIVE")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  tradeIns       TradeIn[]

  @@map("promotion_configs")
}

model TradeIn {
  id             String           @id @default(cuid())
  tradeInNo      String           @unique
  type           TradeInType
  jobId          String?
  promotionId    String?
  customerName   String
  customerPhone  String
  productName    String
  brandName      String?
  sizeCategoryId Int?
  symptom        String?
  discountPct    Float
  status         TradeInStatus    @default(ISSUED)
  walletRef      String?
  createdBy      String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  job            Job?             @relation(fields: [jobId], references: [id])
  promotion      PromotionConfig? @relation(fields: [promotionId], references: [id])

  @@map("trade_ins")
}

model PayoutCycleConfig {
  id          Int     @id @default(autoincrement())
  cycleType   String  @default("BIMONTHLY")
  dayOfMonth1 Int     @default(5)
  dayOfMonth2 Int     @default(20)
  active      Boolean @default(true)

  @@map("payout_cycle_configs")
}

model PayoutBatch {
  id          String            @id @default(cuid())
  batchNo     String            @unique
  periodFrom  DateTime
  periodTo    DateTime
  status      PayoutStatus      @default(PENDING)
  totalAmount Int               @default(0)
  submittedAt DateTime?
  paidAt      DateTime?
  createdBy   String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  lines       PayoutBatchLine[]

  @@map("payout_batches")
}

model PayoutBatchLine {
  id             String       @id @default(cuid())
  batchId        String
  jobId          String
  vendorCenterId String?
  repairAmount   Int
  gpPct          Float
  gpAmount       Int
  netAmount      Int
  status         PayoutStatus @default(PENDING)
  createdAt      DateTime     @default(now())
  batch          PayoutBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  job            Job          @relation(fields: [jobId], references: [id])

  @@map("payout_batch_lines")
}

model RunningNumber {
  prefix    String   @id
  lastSeq   Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("running_numbers")
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model SlaStep_Override {
  id            String @id @default(cuid())
  slaStepId     Int
  centerId      String
  hoursOverride Int

  @@unique([slaStepId, centerId])
  @@map("sla_step_overrides")
}

model RoleMenuPermission {
  id        String  @id @default(cuid())
  menuKey   String
  role      Role
  canAccess Boolean @default(false)
  canWrite  Boolean @default(false)

  @@unique([menuKey, role])
  @@map("role_menu_permissions")
}

enum Role {
  CS
  GR
  DC
  VD
  S2
  ADMIN
  EXECUTIVE
}

enum JobStage {
  PENDING_VENDOR_ASSIGNMENT
  CS_OPENED
  GR_RECEIVED
  GR_PACKED
  OUTBOUND_TO_DC
  AT_DC_OUTBOUND
  OUTBOUND_TO_VD
  VD_INSPECTING
  WAITING_APPROVAL
  REPAIRING
  RETURN_PACKING
  INBOUND_TO_DC
  AT_DC_INBOUND
  INBOUND_TO_BRANCH
  GR_RETURN_RECEIVED
  READY_FOR_PICKUP
  CLOSED_REPAIRED
  CLOSED_NOT_REPAIRED
  CANCELLED
}

enum JobType {
  CUSTOMER
  STOCK
}

enum Channel {
  DC
  DSD
  TPL
}

enum ShipmentStatus {
  PENDING_DISPATCH
  DISPATCHED
  PICKED_UP
  DELIVERED
  CANCELLED
}

enum CarrierType {
  DC_FLEET
  VD_FLEET
  TPL
}

enum ShipmentLegType {
  BRANCH_TO_DC
  DC_TO_VD
  BRANCH_TO_VD
  VD_TO_DC
  VD_TO_BRANCH
  DC_TO_BRANCH
}

enum TokenType {
  TRACKING
  QUOTE
  PAYMENT
  DRIVER
  CSAT
}

enum SlaClockStatus {
  RUNNING
  PAUSED
  STOPPED
}

enum ChargeType {
  OPERATION_FEE
  SHIPPING_FEE
  REPAIR
  OPERATION_FEE_CREDIT
  INSPECTION_FEE
}

enum PaymentMethod {
  PROMPTPAY_QR
  CARD_LINK
  POS_RECEIPT
  CASH
}

enum PaymentStatus {
  PENDING
  PAID
  VOIDED
}

enum QuoteDecision {
  PENDING
  APPROVED
  REJECTED
  AUTO_APPROVED
}

enum QuoteStatus {
  SENT
  SUPERSEDED
  APPROVED
  REJECTED
  EXPIRED
}

enum QuoteLineType {
  INSPECTION_FEE
  PART
  LABOR
  OTHER
}

enum PayoutStatus {
  PENDING
  SENT
  PAID
}

enum TradeInType {
  TYPE1
  TYPE2
}

enum TradeInStatus {
  ISSUED
  USED
  FAILED
  EXPIRED
}

enum SiteType {
  BRANCH
  DC
}

enum VendorApplicationStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

model VendorApplication {
  id                String                  @id @default(cuid())
  applicationNo     String                  @unique
  status            VendorApplicationStatus @default(PENDING_APPROVAL)
  storeName         String
  businessType      String
  taxId             String
  phone             String
  lineId            String?
  branches          Json
  appliances        Json
  isBrandAuthorized Boolean                 @default(false)
  coverage          Json
  documents         Json
  bank              Json
  agreements        Json
  signatureUrl      String?
  estimatedTier     String                  @default("STANDARD")
  estimatedCases    Int                     @default(0)
  score             Int                     @default(0)
  approvedParentId  String?
  adminNotes        String?
  reviewedBy        String?
  reviewedAt        DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@map("vendor_applications")
}
