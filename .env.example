NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://svcm:svcm_password@localhost:5432/svcm_db?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Storage (MinIO / S3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=svcm-attachments
S3_USE_SSL=false

# Auth
JWT_SECRET=svcm_super_secret_jwt_key_for_dev_only_change_in_prod
JWT_REFRESH_SECRET=svcm_super_secret_refresh_jwt_key_for_dev_only
