# Environment variables for Thai Watsadu Repair Center System (SVCM)

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/svc_new_db?schema=public"
NODE_ENV="development"
JWT_SECRET="thaiwatsadu_vservice_secret_key_2026_super_secure"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Vendor approval email (optional — if SMTP_HOST/SMTP_FROM are unset the email is simulated and the admin hands over credentials manually)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Thaiwasadu Service Center <no-reply@example.com>"
APP_BASE_URL=http://localhost:3000

# LINE Messaging API — get these from LINE Developers Console (Messaging API channel)
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# AES-256-GCM key (32 bytes, base64) for encrypting integration secrets in DB. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CONFIG_ENCRYPTION_KEY=
