{
  "name": "svcm-root",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @svcm/db generate",
    "db:migrate": "pnpm --filter @svcm/db migrate",
    "db:studio": "pnpm --filter @svcm/db studio",
    "db:seed": "pnpm --filter @svcm/db seed",
    "e2e": "echo \"e2e placeholder (Step 27)\""
  },
  "devDependencies": {
    "prettier": "^3.5.2",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  }
}
